# ---------------------------------------------------------------------------
# Required: the Safe the agent votes as, and the key it signs with.
# ---------------------------------------------------------------------------

# The Safe smart account. This is the address that appears as the voter.
SAFE_ADDRESS=0xYourSafeAddress

# The agent's signing key. This EOA must be an OWNER of the Safe above.
# It never holds the treasury; it only signs. Give it a small gas balance if
# you vote on-chain. Keep it out of version control.
SAFE_AGENT_PRIVATE_KEY=0xYourAgentPrivateKey

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# 1 Ethereum, 8453 Base, 42161 Arbitrum, 10 Optimism, 137 Polygon, 100 Gnosis.
SAFE_CHAIN_ID=1

# Strongly recommended. Falls back to a public RPC, which is rate limited.
# SAFE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key

# Safe Transaction Service API key, from https://developer.safe.global.
# Required for Snapshot voting, which goes through the Safe message service.
# SAFE_API_KEY=

# Only for self-hosted Safe Transaction Service deployments.
# SAFE_TX_SERVICE_URL=

# ---------------------------------------------------------------------------
# Voting platforms
# ---------------------------------------------------------------------------

# SNAPSHOT_HUB_URL=https://hub.snapshot.org
# SNAPSHOT_SEQUENCER_URL=https://seq.snapshot.org

# Free key from https://www.tally.xyz/user/api-keys. Needed only for on-chain
# proposal discovery; governor_vote and governor_proposal_state work without it.
# TALLY_API_KEY=

# TALLY_API_URL=https://api.tally.xyz/query

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------

# Restrict where the agent may vote. Comma-separated; empty means no limit.
# Setting these is the single most effective safety measure.
# ALLOWED_SNAPSHOT_SPACES=ens.eth,aavedao.eth
# ALLOWED_GOVERNORS=0x408ED6354d4973f66138C91495F2f2FCbd8724C3

# Sign nothing and submit nothing. Every vote tool returns the payload it would
# have sent. Use this for the first run against a real Safe.
DRY_RUN=false

# Directory of voting-policy documents (.md or .txt) exposed to the agent.
KNOWLEDGE_DIR=knowledge
