# ---------------------------------------------------------------------------
# Required: the Safe the agent votes as, and the key it signs with.
# ---------------------------------------------------------------------------

# The Safe smart account. This is the address that appears as the voter.
SAFE_ADDRESS=0xYourSafeAddress

# The agent's signing key. This EOA must be an OWNER of the Safe above.
# It never holds the treasury; it only signs. It is also the account that PAYS
# GAS for on-chain Governor votes, because it submits execTransaction, so fund
# THIS address rather than the Safe if you vote on-chain. Snapshot voting is
# gasless and needs no ETH anywhere. Keep this key out of version control.
SAFE_AGENT_PRIVATE_KEY=0xYourAgentPrivateKey

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# 1 Ethereum, 8453 Base, 42161 Arbitrum, 10 Optimism, 137 Polygon, 100 Gnosis.
SAFE_CHAIN_ID=1

# Strongly recommended. Falls back to a public RPC, which is rate limited.
# SAFE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key

# Safe Transaction Service API key, from https://developer.safe.global.
# Required for Snapshot voting, which goes through the Safe message service.
# SAFE_API_KEY=

# Only for self-hosted Safe Transaction Service deployments.
# SAFE_TX_SERVICE_URL=

# ---------------------------------------------------------------------------
# Voting platforms
# ---------------------------------------------------------------------------

# SNAPSHOT_HUB_URL=https://hub.snapshot.org
# SNAPSHOT_SEQUENCER_URL=https://seq.snapshot.org

# On-chain proposal discovery reads ProposalCreated logs from the Governor
# contract, so NO API KEY IS NEEDED. Tally shut down in March 2026 and is now
# Cactus, run by ScopeLift; the settings below are a legacy fallback only.
# CACTUS_API_KEY=
# CACTUS_API_URL=https://api.tally.xyz/query

# The log scan window is normally derived from the Governor itself, as
# votingDelay + votingPeriod, which is the shortest span that can still
# contain an open proposal. This is only the fallback for a Governor fork that
# does not expose those methods.
GOVERNOR_LOOKBACK=30d

# Slack added to the derived window, to absorb block-time drift and a recent
# change to the Governor's voting parameters.
GOVERNOR_LOOKBACK_MARGIN=2d

# Block span per eth_getLogs call. Most public RPCs cap this around 10k; raise
# it if your provider allows wider ranges, which matters on fast L2s.
GOVERNOR_LOG_CHUNK_BLOCKS=10000

# Refuse a scan needing more calls than this, rather than hammering the RPC.
# Fast chains need a shorter GOVERNOR_LOOKBACK or a larger chunk size.
GOVERNOR_MAX_LOG_CHUNKS=200

# ---------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------

# Restrict where the agent may vote. Comma-separated; empty means no limit.
# Setting these is the single most effective safety measure.
# ALLOWED_SNAPSHOT_SPACES=ens.eth,aavedao.eth
# ALLOWED_GOVERNORS=0x408ED6354d4973f66138C91495F2f2FCbd8724C3

# Sign nothing and submit nothing. Every vote tool returns the payload it would
# have sent. Use this for the first run against a real Safe.
DRY_RUN=false

# Directory of voting-policy documents (.md or .txt) exposed to the agent.
KNOWLEDGE_DIR=knowledge

# ---------------------------------------------------------------------------
# Vote log
# ---------------------------------------------------------------------------

# Append-only JSONL record of every vote attempt. The agent reads it through
# the vote_log tool to stay consistent with its own precedent, and the
# scheduler reads it to avoid voting twice on one proposal.
VOTE_LOG_PATH=data/votes.jsonl

# ---------------------------------------------------------------------------
# Scheduler (safe-mpc-watch) — only needed for unattended voting
# ---------------------------------------------------------------------------

# Snapshot spaces to watch for new proposals. Comma-separated.
# WATCH_SNAPSHOT_SPACES=ens.eth,aavedao.eth

# Governor contracts to watch for on-chain proposals. Discovery is fully
# on-chain, so no API key is involved. These must be on SAFE_CHAIN_ID, since
# the Safe cannot vote on any other chain.
# WATCH_GOVERNORS=0x408ED6354d4973f66138C91495F2f2FCbd8724C3

# Legacy: hosted-indexer slugs. Tally shut down, so prefer WATCH_GOVERNORS.
# WATCH_TALLY_SLUGS=uniswap

# How long before a proposal closes to ask the agent to decide. Voting late
# means the decision reflects how sentiment developed, and leaves room to retry.
VOTE_BEFORE_CLOSE=6h

# How often to poll for new proposals. Ignored with --once.
POLL_INTERVAL=1h

# The command that runs your agent. Parsed into argv and run WITHOUT a shell.
# Placeholders: {prompt} {platform} {proposalId} {venue} {endsAt}
# The proposal title is passed as SAFE_MPC_PROPOSAL_TITLE in the environment,
# never on the command line, because it is untrusted text from a public DAO.
# AGENT_COMMAND=claude -p "{prompt}" --mcp-config .mcp.json --allowedTools mcp__safe-mpc__*

# Give up on one agent run after this long.
AGENT_TIMEOUT=10m

# Where the scheduler keeps its queue.
SCHEDULE_PATH=data/schedule.json
